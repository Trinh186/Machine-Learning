/* =========================================================
   style.qss — style dùng chung cho TOÀN BỘ app (kể cả màn Login).
   Bảng màu:
     nền app      #F4F6FB   sidebar  #0F1B3D   chữ chính #111827
     accent       #3B5BDB   chữ phụ  #6B7280   viền thẻ  #E5E8F0
   Dùng thuộc tính động cssClass (đặt trong Qt Designer: "Add Dynamic Property" → String)
   để áp style: card, cardTitle, cardSubtitle, kpiTitle, kpiValue, kpiNote, navButton.
   ========================================================= */

* {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow, #contentArea, QStackedWidget, QStackedWidget > QWidget {
    background: #F4F6FB;
}

/* ---------------- Sidebar ---------------- */
#sidebar { background: #0F1B3D; }

#lblAppName { color: #FFFFFF; font-size: 16pt; font-weight: 700; padding-left: 8px; }
#lblAppSubtitle { color: #8C97B8; font-size: 9pt; padding-left: 8px; }

#lblMenuSection, #lblAdminSection {
    color: #5E6A8F; font-size: 8pt; font-weight: 700; letter-spacing: 1px;
    padding: 6px 8px 4px 8px;
}

QPushButton[cssClass="navButton"] {
    text-align: left;
    color: #B6BFD9;
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 10pt;
}
QPushButton[cssClass="navButton"]:hover { background: #1A2A55; color: #FFFFFF; }
QPushButton[cssClass="navButton"]:checked {
    background: #3B5BDB; color: #FFFFFF; font-weight: 600;
}

#userBox { background: #18264D; border-radius: 10px; }
#lblUserName { color: #FFFFFF; font-weight: 600; }
#lblUserRole { color: #8C97B8; font-size: 9pt; }
#btnLogout {
    color: #FFFFFF; background: transparent;
    border: 1px solid #3A4A78; border-radius: 7px; padding: 7px;
}
#btnLogout:hover { background: #E03131; border-color: #E03131; }

/* ---------------- Top bar ---------------- */
#topBar { background: #FFFFFF; border-bottom: 1px solid #E5E8F0; }
#lblPageTitle { color: #111827; font-size: 15pt; font-weight: 700; }
#lblPageSubtitle { color: #6B7280; font-size: 9pt; }
#lblDataRange {
    color: #3B5BDB; background: #EDF2FF;
    border-radius: 12px; padding: 5px 12px; font-size: 9pt; font-weight: 600;
}

/* ---------------- Cards ---------------- */
QFrame[cssClass="card"] {
    background: #FFFFFF;
    border: 1px solid #E5E8F0;
    border-radius: 12px;
}
QFrame[cssClass="card"] QLabel { background: transparent; border: none; }
/* Trang con trong QTabWidget nằm trên thẻ trắng: để trong suốt (không kế thừa nền xám của QStackedWidget) */
QFrame[cssClass="card"] QTabWidget,
QFrame[cssClass="card"] QStackedWidget,
QFrame[cssClass="card"] QStackedWidget > QWidget { background: transparent; }

QLabel[cssClass="cardTitle"] { color: #111827; font-size: 11pt; font-weight: 700; }
QLabel[cssClass="cardSubtitle"] { color: #6B7280; font-size: 9pt; }

QLabel[cssClass="kpiTitle"] { color: #6B7280; font-size: 9pt; font-weight: 600; }
QLabel[cssClass="kpiValue"] { color: #111827; font-size: 20pt; font-weight: 700; }
QLabel[cssClass="kpiNote"]  { color: #9AA3B5; font-size: 8.5pt; }

QLabel[cssClass="placeholder"] {
    background: #FFFFFF; border: 1px dashed #C9D0E0; border-radius: 12px;
    color: #111827; font-size: 12pt;
}

/* ---------------- Tables ---------------- */
QTableWidget, QTableView {
    background: #FFFFFF;
    alternate-background-color: #F8FAFD;
    border: none;
    color: #111827;
    selection-background-color: #EDF2FF;
    selection-color: #111827;
}
QHeaderView::section {
    background: #F4F6FB;
    color: #6B7280;
    font-size: 9pt;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid #E5E8F0;
    padding: 8px 10px;
}
QTableWidget::item { padding: 0 10px; border-bottom: 1px solid #F0F2F7; }

/* ---------------- Inputs & buttons (dùng cho các trang sau) ---------------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background: #FFFFFF; color: #111827;
    border: 1px solid #D5DAE6; border-radius: 8px; padding: 7px 10px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 1px solid #3B5BDB;
}
QPushButton[cssClass="primary"] {
    background: #3B5BDB; color: #FFFFFF; border: none;
    border-radius: 8px; padding: 8px 16px; font-weight: 600;
}
QPushButton[cssClass="primary"]:hover { background: #2B48C0; }
QPushButton[cssClass="secondary"] {
    background: #FFFFFF; color: #3B5BDB; border: 1px solid #3B5BDB;
    border-radius: 8px; padding: 8px 16px; font-weight: 600;
}

QToolTip { background: #111827; color: #FFFFFF; border: none; padding: 6px 8px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #CBD2E1; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ======================= Task 11: Transaction Data, RFM & Model ======================= */
QLabel[cssClass="fieldLabel"] { color: #374151; font-size: 9pt; font-weight: 600; }
QLabel[cssClass="hint"] { color: #9AA3B5; font-size: 8.5pt; }
QLabel[cssClass="pageInfo"] { color: #374151; font-size: 9pt; padding: 0 6px; }
QLabel[cssClass="pill"] {
    color: #3B5BDB; background: #EDF2FF; border-radius: 11px;
    padding: 4px 12px; font-size: 9pt; font-weight: 600;
}

QPushButton[cssClass="primary"]:disabled { background: #A5B4F0; }
QPushButton[cssClass="secondary"]:hover { background: #EDF2FF; }
QPushButton[cssClass="secondary"]:disabled { color: #B8C0D4; border-color: #D5DAE6; background: #FFFFFF; }

QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 22px; }
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 18px; border: none; }
QComboBox QAbstractItemView {
    background: #FFFFFF; color: #111827; border: 1px solid #D5DAE6;
    selection-background-color: #EDF2FF; selection-color: #111827;
}

QTabWidget::pane { border: none; border-top: 1px solid #E5E8F0; top: -1px; }
QTabBar::tab {
    background: transparent; color: #6B7280; padding: 8px 16px; margin-right: 4px;
    border: none; border-bottom: 2px solid transparent; font-weight: 600;
}
QTabBar::tab:selected { color: #3B5BDB; border-bottom: 2px solid #3B5BDB; }
QTabBar::tab:hover:!selected { color: #111827; }

QFrame[cssClass="resultBox"] {
    background: #F8FAFD; border: 1px solid #E5E8F0; border-radius: 10px;
}
QLabel[cssClass="resultCaption"] { color: #9AA3B5; font-size: 8pt; font-weight: 700; letter-spacing: 1px; padding-top: 4px; }
QLabel[cssClass="resultSegment"] { color: #111827; font-size: 13pt; font-weight: 700; }
QLabel[cssClass="resultSub"] { color: #374151; font-size: 9.5pt; font-weight: 600; }
QLabel[cssClass="resultBody"] { color: #4B5563; font-size: 9pt; }

/* ======================= Task 12: Segmentation, Cluster Analysis & Marketing ======================= */
QFrame[cssClass="segmentCard"] {
    background: #FFFFFF; border: 1px solid #E5E8F0; border-radius: 12px;
}
QFrame[cssClass="segmentCard"]:hover { border: 1px solid #A5B4F0; }
QFrame[cssClass="segmentCard"][selected="true"] { border: 2px solid #3B5BDB; background: #F7F9FF; }
QFrame[cssClass="segmentCard"] QLabel { background: transparent; border: none; }
QLabel[cssClass="segmentCardTitle"] { font-size: 10.5pt; font-weight: 700; }

QPushButton[cssClass="link"] {
    background: transparent; border: none; color: #E03131; font-size: 9pt; padding: 4px 6px;
}
QPushButton[cssClass="link"]:hover { text-decoration: underline; }

QListWidget[cssClass="actionList"] {
    background: #FFFFFF; border: 1px solid #E5E8F0; border-radius: 8px; padding: 4px; color: #111827;
}
QListWidget[cssClass="actionList"]::item { padding: 7px 8px; border-radius: 6px; }
QListWidget[cssClass="actionList"]::item:hover { background: #F4F6FB; }
QListWidget[cssClass="actionList"]::item:selected { background: #EDF2FF; color: #2B48C0; }
