/* =========================================================
   style.qss — style dùng chung cho TOÀN BỘ app (kể cả màn Login).
   THEME HỒNG – TÍM + họa tiết hoa lá (ảnh trong ui/assets/, @ASSETS@ được thay khi nạp — xem app/theme.py)
   Bảng màu:
     nền app      #FBF4F9   sidebar  #3A1C4F → #6A2A6E (gradient)   chữ chính #2D1B36
     accent       #A23E9C   hồng #D0509E → tím #8E44B5 (nút chính)    chữ phụ  #7D6A84   viền thẻ #F0DDEB
   Dùng thuộc tính động cssClass (đặt trong Qt Designer: "Add Dynamic Property" → String)
   để áp style: card, cardTitle, cardSubtitle, kpiTitle, kpiValue, kpiNote, navButton.
   ========================================================= */

* {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow, #contentArea, QStackedWidget, QStackedWidget > QWidget {
    background: #FBF4F9;
}

/* ---------------- Sidebar ---------------- */
#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3A1C4F, stop:0.6 #52235F, stop:1 #6A2A6E);
    background-image: url(@ASSETS@/sidebar_floral.svg);
    background-position: bottom left;
    background-repeat: no-repeat;
}

#lblAppName { color: #FFFFFF; font-size: 16pt; font-weight: 700; padding-left: 8px; }
#lblAppSubtitle { color: #D9BFE3; font-size: 9pt; padding-left: 8px; }

#lblMenuSection, #lblAdminSection {
    color: #C59BD3; font-size: 8pt; font-weight: 700; letter-spacing: 1px;
    padding: 6px 8px 4px 8px;
}

QPushButton[cssClass="navButton"] {
    text-align: left;
    color: #EBD8F1;
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 10px 8px;
    font-size: 10pt;
    font-weight: 400;
}
QPushButton[cssClass="navButton"]:hover { background: #55296E; color: #FFFFFF; }
QPushButton[cssClass="navButton"]:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #D0509E, stop:1 #8E44B5); color: #FFFFFF; font-weight: 600;
}

#userBox { background: rgba(255, 255, 255, 22); border: 1px solid rgba(255, 255, 255, 30); border-radius: 12px; }
#lblUserName { color: #FFFFFF; font-weight: 600; }
#lblUserRole { color: #D9BFE3; font-size: 9pt; }
#btnLogout {
    color: #FFFFFF; background: transparent;
    border: 1px solid #8A5A9E; border-radius: 7px; padding: 7px;
}
#btnLogout:hover { background: #D6336C; border-color: #D6336C; }

/* ---------------- Top bar ---------------- */
#topBar {
    background: #FFFFFF; border-bottom: 1px solid #F0DDEB;
    background-image: url(@ASSETS@/topbar_floral.svg);
    background-position: right bottom; background-repeat: no-repeat;
}
#lblPageTitle { color: #2D1B36; font-size: 15pt; font-weight: 700; }
#lblPageSubtitle { color: #7D6A84; font-size: 9pt; }
#lblDataRange {
    color: #A23E9C; background: #FFFFFF; border: 1px solid #F0C9E3;
    border-radius: 12px; padding: 5px 12px; font-size: 9pt; font-weight: 600;
}

/* ---------------- Cards ---------------- */
QFrame[cssClass="card"] {
    background: #FFFFFF;
    border: 1px solid #F0DDEB;
    border-radius: 14px;
}
QFrame[cssClass="card"] QLabel { background: transparent; border: none; }
/* Trang con trong QTabWidget nằm trên thẻ trắng: để trong suốt (không kế thừa nền xám của QStackedWidget) */
QFrame[cssClass="card"] QTabWidget,
QFrame[cssClass="card"] QStackedWidget,
QFrame[cssClass="card"] QStackedWidget > QWidget { background: transparent; }

QLabel[cssClass="cardTitle"] { color: #2D1B36; font-size: 11pt; font-weight: 700; }
QLabel[cssClass="cardSubtitle"] { color: #7D6A84; font-size: 9pt; }

QLabel[cssClass="kpiTitle"] { color: #7D6A84; font-size: 9pt; font-weight: 600; }
QLabel[cssClass="kpiValue"] { color: #2D1B36; font-size: 20pt; font-weight: 700; }
QLabel[cssClass="kpiNote"]  { color: #AD9AB2; font-size: 8.5pt; }

QLabel[cssClass="placeholder"] {
    background: #FFFFFF; border: 1px dashed #E1C2D9; border-radius: 12px;
    color: #2D1B36; font-size: 12pt;
}

/* ---------------- Tables ---------------- */
QTableWidget, QTableView {
    background: #FFFFFF;
    alternate-background-color: #FDF8FC;
    border: none;
    color: #2D1B36;
    selection-background-color: #FAE8F4;
    selection-color: #2D1B36;
}
QHeaderView::section {
    background: #FBF4F9;
    color: #7D6A84;
    font-size: 9pt;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid #F0DDEB;
    padding: 8px 10px;
}
QTableWidget::item { padding: 0 10px; border-bottom: 1px solid #F7EAF3; }

/* ---------------- Inputs & buttons (dùng cho các trang sau) ---------------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background: #FFFFFF; color: #2D1B36;
    border: 1px solid #E6CCDF; border-radius: 8px; padding: 7px 10px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 1px solid #A23E9C;
}
QPushButton[cssClass="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #D0509E, stop:1 #8E44B5); color: #FFFFFF; border: none;
    border-radius: 8px; padding: 8px 16px; font-weight: 600;
}
QPushButton[cssClass="primary"]:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #B8408A, stop:1 #7A3A9E); }
QPushButton[cssClass="secondary"] {
    background: #FFFFFF; color: #A23E9C; border: 1px solid #A23E9C;
    border-radius: 8px; padding: 8px 16px; font-weight: 600;
}

QToolTip { background: #2D1B36; color: #FFFFFF; border: none; padding: 6px 8px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #E2C4DA; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ======================= Task 11: Transaction Data, RFM & Model ======================= */
QLabel[cssClass="fieldLabel"] { color: #4A3552; font-size: 9pt; font-weight: 600; }
QLabel[cssClass="hint"] { color: #AD9AB2; font-size: 8.5pt; }
QLabel[cssClass="pageInfo"] { color: #4A3552; font-size: 9pt; padding: 0 6px; }
QLabel[cssClass="pill"] {
    color: #A23E9C; background: #FAE8F4; border-radius: 11px;
    padding: 4px 12px; font-size: 9pt; font-weight: 600;
}

QPushButton[cssClass="primary"]:disabled { background: #DDB3D8; }
QPushButton[cssClass="secondary"]:hover { background: #FAE8F4; }
QPushButton[cssClass="secondary"]:disabled { color: #CFB9C9; border-color: #E6CCDF; background: #FFFFFF; }

QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 22px; }
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 18px; border: none; }
QComboBox QAbstractItemView {
    background: #FFFFFF; color: #2D1B36; border: 1px solid #E6CCDF;
    selection-background-color: #FAE8F4; selection-color: #2D1B36;
}

QTabWidget::pane { border: none; border-top: 1px solid #F0DDEB; top: -1px; }
QTabBar::tab {
    background: transparent; color: #7D6A84; padding: 8px 16px; margin-right: 4px;
    border: none; border-bottom: 2px solid transparent; font-weight: 600;
}
QTabBar::tab:selected { color: #A23E9C; border-bottom: 2px solid #A23E9C; }
QTabBar::tab:hover:!selected { color: #2D1B36; }

QFrame[cssClass="resultBox"] {
    background: #FDF8FC; border: 1px solid #F0DDEB; border-radius: 10px;
}
QLabel[cssClass="resultCaption"] { color: #AD9AB2; font-size: 8pt; font-weight: 700; letter-spacing: 1px; padding-top: 4px; }
QLabel[cssClass="resultSegment"] { color: #2D1B36; font-size: 13pt; font-weight: 700; }
QLabel[cssClass="resultSub"] { color: #4A3552; font-size: 9.5pt; font-weight: 600; }
QLabel[cssClass="resultBody"] { color: #5B4762; font-size: 9pt; }

/* ======================= Task 12: Segmentation, Cluster Analysis & Marketing ======================= */
QFrame[cssClass="segmentCard"] {
    background: #FFFFFF; border: 1px solid #F0DDEB; border-radius: 12px;
}
QFrame[cssClass="segmentCard"]:hover { border: 1px solid #DDB3D8; }
QFrame[cssClass="segmentCard"][selected="true"] { border: 2px solid #A23E9C; background: #FDF3FA; }
QFrame[cssClass="segmentCard"] QLabel { background: transparent; border: none; }
QLabel[cssClass="segmentCardTitle"] { font-size: 10.5pt; font-weight: 700; }

QPushButton[cssClass="link"] {
    background: transparent; border: none; color: #D6336C; font-size: 9pt; padding: 4px 6px;
}
QPushButton[cssClass="link"]:hover { text-decoration: underline; }

QListWidget[cssClass="actionList"] {
    background: #FFFFFF; border: 1px solid #F0DDEB; border-radius: 8px; padding: 4px; color: #2D1B36;
}
QListWidget[cssClass="actionList"]::item { padding: 7px 8px; border-radius: 6px; }
QListWidget[cssClass="actionList"]::item:hover { background: #FBF4F9; }
QListWidget[cssClass="actionList"]::item:selected { background: #FAE8F4; color: #7E2E7E; }

/* ======================= Theme hồng – tím: chi tiết thêm ======================= */
/* Nút mặc định (User Management, hộp thoại...) */
QPushButton {
    background: #FFFFFF; color: #7E2E7E; border: 1px solid #E6CCDF;
    border-radius: 8px; padding: 7px 14px; font-weight: 600;
}
QPushButton:hover { background: #FAE8F4; border-color: #DDB3D8; }
QPushButton:disabled { color: #CFB9C9; border-color: #F0DDEB; background: #FFFFFF; }

/* Nhành lá nhỏ ở góc các thẻ số liệu */
#cardKpiCustomers, #cardKpiInvoices, #cardKpiRevenue, #cardKpiSegments,
#cardMetricK, #cardMetricSilhouette, #cardMetricDaviesBouldin, #cardMetricCalinski {
    background-image: url(@ASSETS@/card_sprig.svg);
    background-position: bottom right; background-repeat: no-repeat;
}

/* Màn đăng nhập */
#LoginMainWindow, #LoginMainWindow #centralwidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FFF7FB, stop:1 #F5EAFB);
}
#LoginMainWindow #centralwidget {
    background-image: url(@ASSETS@/login_floral.svg);
    background-position: bottom right; background-repeat: no-repeat;
}
#LoginMainWindow QLabel { background: transparent; }

QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #A23E9C; }
QProgressBar { background: #FAE8F4; border: none; border-radius: 6px; }
QProgressBar::chunk { background: #A23E9C; border-radius: 6px; }
